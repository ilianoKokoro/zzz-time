{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "zzz-time",
    "identifier": "ca.ilianokokoro.zzz-time",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "ZZZ Time",
                "width": 700,
                "height": 500,
                "minWidth": 400,
                "minHeight": 400,
                "maxWidth": 1700,
                "maxHeight": 1000,
                "transparent": true,
                "maximizable": false,
                "decorations": true,
                "visible": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installerIcon": "icons/icon.ico"
            }
        }
    }
}
